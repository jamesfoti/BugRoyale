#!/usr/bin/env python
# The terrain extension. Build from this folder:
#   python -m SCons target=template_debug     (the editor and debug runs)
#   python -m SCons target=template_release   (exported games)
# The library lands in ../bin/, where terrain.gdextension finds it.

env = SConscript("godot-cpp/SConstruct", {"api_version": "4.7"})

env.Append(CPPPATH=["src/", "thirdparty/fastnoise/"])
sources = Glob("src/*.cpp")

if env["platform"] == "macos":
    library = env.SharedLibrary(
        "../bin/libterrain.{}.{}.framework/libterrain.{}.{}".format(
            env["platform"], env["target"], env["platform"], env["target"]
        ),
        source=sources,
    )
else:
    library = env.SharedLibrary(
        "../bin/libterrain{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
        source=sources,
    )

env.NoCache(library)
Default(library)
